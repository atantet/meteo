# Template de configuration locale — copier en `.env` et remplir.
# Le fichier .env est listé dans .gitignore et ne doit JAMAIS être commité.
# Cf. ADR-0001 — Publication policy, règle 1.

# Token Météo-France (portail-api.meteofrance.fr)
# Obtention :
#   1. Ouvrir un compte sur https://portail-api.meteofrance.fr/
#   2. Souscrire aux APIs DPObs, DPClim, DPPaquetObs
#   3. Aller sur le Dashboard, "Générer Token"
#   4. Copier l'Application ID (longue chaîne après "Authorization: Basic")
METEOFRANCE_TOKEN=

# Coordonnées du site de référence (centroïde Pleine-Fougères par défaut)
# Granularité commune — cf. ADR-0001 règle 3 — coordonnées parcelles précises
# restent locales et ne sont pas versionnées.
SITE_LATITUDE=48.46
SITE_LONGITUDE=-1.55
SITE_ALTITUDE=30

# (à venir) — destinataires email pour app veille
# VEILLE_EMAIL_TO=
