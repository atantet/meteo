# Template de configuration locale — copier en `.env` et remplir.
# Le fichier .env est listé dans .gitignore et ne doit JAMAIS être commité.
# Cf. ADR-0001 — Publication policy, règle 1.

# Token Météo-France (portail-api.meteofrance.fr)
# Obtention :
#   1. Ouvrir un compte sur https://portail-api.meteofrance.fr/
#   2. Souscrire aux APIs DPObs, DPClim, DPPaquetObs
#   3. Aller sur le Dashboard, "Générer Token"
#   4. Copier l'Application ID (longue chaîne après "Authorization: Basic")
METEOFRANCE_TOKEN=

# Coordonnées du site de référence : 8 La Petite Claye, 35610 Pleine-Fougères
# (géocodage BAN). Inscrites en clair cf. ADR-0001 règle 3 :
# l'adresse étant publiquement disponible au cadastre, elle l'est aussi ici.
# Les coordonnées exactes des parcelles cultivées restent locales (NON
# versionnées) si on les utilise un jour.
SITE_LATITUDE=48.543648
SITE_LONGITUDE=-1.611515
SITE_ALTITUDE=30

# App 1 Veille — SMTP (cf. config/veille.yaml et ADR-0001 règle 1)
#
# Choix v0 : Gmail compte perso, avec App Password (mot de passe dédié
# 16 caractères, révocable). Voir setup dans project_mail_pro.md.
#
# Pour Gmail :
#     VEILLE_SMTP_HOST=smtp.gmail.com
#     VEILLE_SMTP_PORT=587
#     VEILLE_SMTP_USER=votre.adresse@gmail.com
#     VEILLE_SMTP_PASSWORD=<app password Gmail, 16 caractères>
#     VEILLE_EMAIL_FROM=votre.adresse@gmail.com
#
# Pour Posteo (alternative) :
#     VEILLE_SMTP_HOST=smtp.posteo.de
#     VEILLE_SMTP_USER=votre.adresse@posteo.net
#     (pas d'App Password — mot de passe principal du compte)
#
# Pour OVH (autre alternative) :
#     VEILLE_SMTP_HOST=ssl0.ovh.net
#     VEILLE_SMTP_USER=votre.adresse@votre-domaine.fr
VEILLE_SMTP_HOST=smtp.gmail.com
VEILLE_SMTP_PORT=587
VEILLE_SMTP_USER=
VEILLE_SMTP_PASSWORD=
VEILLE_EMAIL_FROM=
VEILLE_EMAIL_TO=
